# FalkorDB connection. Used when you run `python app.py` yourself (FalkorDB Cloud or a local container).
# Docker Compose ignores these and connects the app to its own FalkorDB container.
# Leave USERNAME and PASSWORD empty for the local container.
FALKOR_HOST=
FALKOR_PORT=
FALKOR_USERNAME=
FALKOR_PASSWORD=

# LLM: any OpenAI-compatible chat API that supports tool calling (required in every setup).
# Pin one specific model rather than a rotating alias.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=

# Optional tuning (defaults shown)
# LLM_TIMEOUT=30
# CASE_TTL_MINUTES=15
# BILLING_MAX_TURNS=4
